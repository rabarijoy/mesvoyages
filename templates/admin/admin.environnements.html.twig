{% extends "baseadmin.html.twig" %}

{% block body %}
    <form class="form-inline mt-1" action="{{ path('admin.environnement.ajout') }}">
        <div class="form-group mr-1 mb-2">
            <input type="text" name="nom" class="sm">
            <button type="submit" class="btn btn-primary mb-2 btn-sm">Ajouter</button>
        </div>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for environnement in environnements %}
                <tr>
                    <td>{{ environnement.nom }}</td>
                    <td>
                        <a href="{{ path('admin.environnement.suppr', {'id': environnement.id}) }}"class="btn btn-danger">Supprimer</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun environnement trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}